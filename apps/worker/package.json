{
  "name": "@fineduc/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fineduc/config": "workspace:*",
    "@fineduc/db": "workspace:*",
    "@fineduc/domain": "workspace:*",
    "@fineduc/money": "workspace:*",
    "@fineduc/providers": "workspace:*",
    "@fineduc/services": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@fineduc/api": "workspace:*"
  }
}
