# Validated by packages/config/src/env.ts at boot. Real secrets NEVER go in this file.
# Provider credentials below are optional in development/test (Fake/Console
# adapters need none of them) but REQUIRED when NODE_ENV=production.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=

# Migrator/owner role — used only by `prisma migrate`.
DATABASE_URL=postgresql://fineduc:fineduc@localhost:5432/fineduc
# The least-privilege `fineduc_app` role the API/worker actually connect as.
# Empty in dev/test — db/src/client.ts derives it from DATABASE_URL with the
# migration's well-known dev password. REQUIRED in production, where that
# password must never be reused.
APP_DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Origin of the PUBLIC parent-facing app (apps/pay). Baked into the moratoire
# link inside reminder messages, so a wrong value here is not a broken page —
# it is a message already delivered with a dead link and no way to recall it.
# Must NOT be localhost in production; the config refuses to boot if it is.
PUBLIC_PAY_URL=http://localhost:3030
JWT_SECRET=
# Exactly 64 hex characters (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=

CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_WEBHOOK_SECRET=

# Chariow — Fineduc's OWN subscription billing (platform account).
# Chariow charges a pre-priced product; one per plan (monthly only).
# CHARIOW_WEBHOOK_SECRET is the PULSE SIGNING SECRET (whsec_...), read from
# Automations -> Pulses -> your Pulse -> Overview. Chariow generates it — it is
# NOT the API key and not derived from it. Rotating it takes effect instantly.
CHARIOW_API_KEY=
CHARIOW_WEBHOOK_SECRET=
CHARIOW_PRODUCT_ESSENTIEL_MONTHLY=
CHARIOW_PRODUCT_CROISSANCE_MONTHLY=
CHARIOW_PRODUCT_INSTITUTION_MONTHLY=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
SMS_API_KEY=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Dashboard URL for the landing page's "Se connecter" button.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3020/login
# API URL for the dashboard's login and data fetching.
NEXT_PUBLIC_API_URL=http://localhost:3010

# Optional: LLM-backed free-text parser for the moratoire chat.
# Without these, the chat uses buttons only — no degradation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=claude-haiku-4-5-20251001

SENTRY_DSN=
